{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "godot-mcp-toolkit": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@npgamedev/godot-mcp-server@latest"
        ],
        "cwd": ".",
        "environment": {
          "GODOT_MCP_CONFIG_VERSION": "1"
        },
        "timeout": {
          "startup": 60000,
          "catalog": 60000
        }
      }
    }
  }
}
