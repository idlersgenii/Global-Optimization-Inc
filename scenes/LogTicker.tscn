[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/log_ticker.gd" id="1_script"]

[node name="LogTicker" type="PanelContainer"]
custom_minimum_size = Vector2(0, 126)
layout_mode = 2
theme_type_variation = &"LogPanel"
script = ExtResource("1_script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Header" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LiveDot" type="Label" parent="Layout/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LogTitle"
text = "●"

[node name="Title" type="Label" parent="Layout/Header"]
layout_mode = 2
theme_type_variation = &"LogTitle"
text = "КОРПОРАТИВНАЯ КОНСОЛЬ"

[node name="Spacer" type="Control" parent="Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Channel" type="Label" parent="Layout/Header"]
layout_mode = 2
theme_type_variation = &"LogMeta"
text = "CH-04 // BUREAUCRACY-OS v3.7 // СТАЖЁР-ДОСТУП"

[node name="MarqueeFrame" type="Control" parent="Layout"]
unique_name_in_owner = true
clip_contents = true
custom_minimum_size = Vector2(0, 18)
layout_mode = 2

[node name="MarqueeLabel" type="Label" parent="Layout/MarqueeFrame"]
unique_name_in_owner = true
layout_mode = 0
theme_type_variation = &"LogMarquee"
text = "СИНЕРГИЯ — ЭТО КОГДА ДВА СТАЖЁРА РАБОТАЮТ ЗА ОДНУ ЗАРПЛАТУ"
vertical_alignment = 1

[node name="Separator" type="HSeparator" parent="Layout"]
layout_mode = 2

[node name="LogText" type="RichTextLabel" parent="Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 74)
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"LogRichText"
bbcode_enabled = true
scroll_active = true
scroll_following = true
selection_enabled = true

[node name="BlinkTimer" type="Timer" parent="."]
wait_time = 0.75
autostart = true

[node name="AmbientTimer" type="Timer" parent="."]
wait_time = 24.0
one_shot = true
autostart = true

[node name="PumpTimer" type="Timer" parent="."]
one_shot = true
